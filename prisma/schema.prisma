// Taskflow — Schéma de données (MVP)
// Gestion de projets et de tâches, inspiré d'Asana.
//
// Hiérarchie : Workspace (espace de travail partagé) → Project → Task.
// Les utilisateurs rejoignent un workspace via une Membership (rôle OWNER/MEMBER).
// Les tâches sont assignables à un membre du workspace, avec échéance et priorité.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 : l'URL de connexion est définie dans prisma.config.ts (migrations)
  // et passée au PrismaClient via le driver adapter (runtime, src/lib/prisma.ts).
}

// Rôle d'un utilisateur au sein d'un workspace.
enum WorkspaceRole {
  OWNER // créateur de l'espace — administrateur protégé (non modifiable/désactivable)
  ADMIN // administrateur : peut inviter, désactiver et gérer les rôles
  MEMBER // utilisateur : accès aux projets et tâches
}

// Visibilité d'un projet (tâche racine). Seules les tâches de 1er niveau la
// portent ; les sous-tâches héritent de celle de leur projet.
enum ProjectVisibility {
  WORKSPACE // accessible à tous les membres de l'espace
  RESTRICTED // accessible au créateur, aux membres listés (et à l'OWNER de l'espace)
}

// Rôle d'une personne AU SEIN d'un projet (distinct des rôles d'espace).
//  - ADMIN  : gère les membres du projet et son ouverture ;
//  - MEMBER : accède au projet sans le gérer.
enum ProjectMemberRole {
  ADMIN
  MEMBER
}

// Formule d'abonnement d'un espace. Les limites associées sont définies en code
// (src/lib/plans.ts), pas en base. Choisie par l'administrateur à la création
// de l'espace, modifiable ensuite depuis la page d'administration.
enum WorkspacePlan {
  FREE
  PRO
  BUSINESS
}

// Statut d'avancement d'une tâche.
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

// Priorité d'une tâche.
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

// Type d'événement du journal d'activité d'une tâche.
enum TaskActivityType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  ASSIGNED
  TITLE_CHANGED
  DESCRIPTION_CHANGED
  SUBTASK_ADDED
  SUBTASK_REMOVED
  COMMENT_ADDED
  MENTIONED
  FOLLOWER_ADDED // ajouté comme suiveur d'une tâche (événement ciblé)
  DECISION_ADDED // décision ajoutée à une tâche
  DOCUMENT_ADDED // document (fichier ou lien) ajouté à une tâche
}

// Canal de livraison d'une catégorie de notification par email.
//  - INSTANT : email immédiat (événement adressé, actionnable) ;
//  - DIGEST  : regroupé dans le récapitulatif périodique ;
//  - OFF      : jamais d'email (reste visible dans le flux in-app).
enum NotifChannel {
  INSTANT
  DIGEST
  OFF
}

// Cadence du récapitulatif (digest) d'un utilisateur.
enum DigestFrequency {
  HOURLY
  DAILY
}

// --- Utilisateur ---
model User {
  id           String   @id @default(cuid())
  // name = nom complet affiché, maintenu synchronisé = "firstName lastName".
  firstName    String   @default("")
  lastName     String   @default("")
  name         String
  email        String   @unique
  passwordHash String
  // Rôle superadmin applicatif (niveau plateforme, distinct des rôles d'espace).
  // Préparé pour l'avenir : aucune UI ne l'utilise encore en v1 (le recouvrement
  // se fait via scripts/recouvrement.ts, lancé par le superadmin). Peut aussi être
  // octroyé par l'allowlist d'emails SUPERADMIN_EMAILS (cf. lib/auth/superadmin).
  isSuperAdmin Boolean  @default(false)
  // Photo de profil (stockée en base ; servie par /api/avatar/[userId]).
  // Cadrage non destructif par point focal (x, y ∈ [0,100]) + zoom (≥ 100).
  photoData      Bytes?
  photoMime      String?
  photoX         Int       @default(50)
  photoY         Int       @default(50)
  photoZoom      Int       @default(100)
  photoUpdatedAt DateTime?
  // Date de dernière consultation de la page « Événements » (calcul des non-lus).
  eventsReadAt   DateTime?
  // Curseur du digest email : borne basse du prochain récapitulatif.
  lastDigestAt   DateTime?
  // Langue d'interface préférée (fr | en | es) ; sert de défaut à la connexion.
  locale         String?
  // Pseudo affiché dans le module Idées (choisi une fois puis réutilisé).
  // null = pas encore choisi ; demandé à la première idée ou au premier pouce.
  pseudo         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notificationPreference NotificationPreference?
  notificationOutbox     NotificationOutbox[]
  emailChanges  EmailChangeRequest[]
  passwordResets PasswordResetRequest[]
  memberships   Membership[]
  membershipEvents MembershipEvent[]
  createdTasks  Task[]       @relation("TaskCreatedBy")
  assignedTasks Task[]       @relation("TaskAssignee")
  sentInvitations Invitation[] @relation("InvitationInvitedBy")
  comments      Comment[]    @relation("CommentAuthor")
  follows       TaskFollow[] @relation("TaskFollower")
  activities    TaskActivity[] @relation("ActivityActor")
  targetedActivities TaskActivity[] @relation("ActivityTarget")
  uploadedDocuments Document[]   @relation("DocumentUploader")
  decisions     Decision[]   @relation("DecisionAuthor")
  projectAccess ProjectAccess[] @relation("ProjectAccessUser")
  authoredIdeas Idea[]       @relation("IdeaAuthor")
  ideaVotes     IdeaVote[]
  ideaComments  IdeaComment[] @relation("IdeaCommentAuthor")
  recoveryActions RecoveryAction[] @relation("RecoveryActor")

  @@index([email])
}

// --- Espace de travail (équipe) ---
model Workspace {
  id         String        @id @default(cuid())
  name       String
  // Formule d'abonnement (limites définies en code). Défaut : FREE.
  plan       WorkspacePlan @default(FREE)
  // Plafond de budget mensuel (centimes) fixé par l'admin sur une offre payante.
  // null = non défini → aucun membre ne peut être ajouté (cf. lib/billing/budget).
  // Les sièges autorisés = budgetCapCents / prix unitaire de la formule.
  budgetCapCents Int?
  // --- Facturation à l'usage au mois civil (une facture par mois) ---
  // Début du segment de facturation courant (null = pas de segment payant en
  // cours, ex. FREE). Remis au 1er du mois à chaque passage de mois ; porte le
  // jour de souscription tant que le premier mois n'est pas clôturé (cf. lib/billing/cycle).
  billingCycleStart DateTime?
  // Changement d'offre choisi dans l'UI mais PAS encore appliqué : il devient
  // effectif au prochain « traitement de nuit » (null = aucun changement en attente).
  pendingPlan           WorkspacePlan?
  // Plafond choisi en même temps que l'offre en attente, appliqué avec elle la nuit.
  pendingBudgetCapCents Int?
  // Jour (minuit) du dernier traitement de nuit appliqué : garde-fou d'idempotence
  // pour n'évaluer l'état de facturation qu'une fois par jour.
  lastBilledOn          DateTime?
  // Coupure administrative (recouvrement) : non null = espace suspendu pour
  // facture échue impayée. Posé par la boucle de recouvrement du traitement de
  // nuit ; levé UNIQUEMENT par le superadmin (scripts/recouvrement.ts), jamais en
  // self-service ni automatiquement. Données conservées (pas de suppression).
  suspendedAt           DateTime?
  // --- Stripe (encaissement des factures mensuelles) ---
  // Customer Stripe de l'espace (null = pas encore créé). Créé à la 1re mise en
  // place du paiement. Unique : un espace ↔ un Customer.
  stripeCustomerId             String? @unique
  // Moyen de paiement par défaut enregistré via Checkout (mode setup). Stocké pour
  // l'affichage « carte enregistrée » sans appel Stripe ; la source de vérité reste
  // le Customer côté Stripe (invoice_settings.default_payment_method).
  stripeDefaultPaymentMethodId String?
  archivedAt DateTime? // non null = espace archivé (préalable à la suppression)
  // Restriction d'accès par domaine email : liste des domaines autorisés pour
  // devenir / rester membre (ex. ["acme.com", "acme.fr"]). Vide = aucune
  // restriction. Appliquée à l'invitation, à l'acceptation et au changement
  // d'adresse email ; les membres déjà en place ne sont pas retirés (grandfathering).
  allowedEmailDomains String[] @default([])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  members     Membership[]
  membershipEvents MembershipEvent[]
  billingSegments BillingSegment[]
  invoices    Invoice[]
  tasks       Task[]
  invitations Invitation[]
  documents   Document[]
  recoveryActions RecoveryAction[]
  // Informations d'entreprise (volet Identité de l'administration), 1-1.
  organizationProfile OrganizationProfile?
}

// --- Informations d'entreprise d'un espace (volet Identité) ---
// Relation 1-1 avec Workspace, isolée pour ne pas alourdir le modèle principal.
// Champs texte uniquement en v1 (le logo est prévu pour une itération ultérieure).
model OrganizationProfile {
  id           String   @id @default(cuid())
  legalName    String // Raison sociale — requis (>= 2 caractères)
  siret        String? // 14 chiffres si renseigné
  vatNumber    String?
  addressLine1 String?
  postalCode   String?
  city         String?
  country      String   @default("France")
  contactEmail String? // format email si renseigné
  phone        String?
  updatedAt    DateTime @updatedAt

  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// --- Invitation à rejoindre un workspace (par email) ---
// Un jeton aléatoire est envoyé dans le lien email ; seul son hash est stocké.
model Invitation {
  id          String        @id @default(cuid())
  email       String // destinataire (peut ne pas encore avoir de compte)
  tokenHash   String        @unique
  role        WorkspaceRole @default(MEMBER)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User      @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([workspaceId])
  @@index([email])
}

// --- Appartenance d'un utilisateur à un workspace ---
model Membership {
  id          String        @id @default(cuid())
  role        WorkspaceRole @default(MEMBER)
  // non null = membre désactivé : il n'a plus accès à l'espace (réactivable).
  deactivatedAt DateTime?
  createdAt   DateTime      @default(now())

  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// Type d'événement du journal d'appartenance (facturation à l'usage).
enum MembershipEventType {
  ACTIVATED // membre ajouté / invitation acceptée / membre réactivé
  DEACTIVATED // membre désactivé
}

// --- Journal d'appartenance (append-only) ---
// Source de vérité de la facturation à l'usage « utilisateur-mois » : chaque
// activation ou désactivation d'un membre y est consignée, horodatée. Jamais de
// mise à jour ni de suppression (hors cascade si l'utilisateur ou l'espace
// disparaît). Le `deactivatedAt` de Membership reste l'état courant ; ce journal
// en porte l'historique, nécessaire pour reconstituer les périodes d'activité.
model MembershipEvent {
  id          String              @id @default(cuid())
  type        MembershipEventType
  at          DateTime            @default(now())

  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([workspaceId, at])
}

// --- Segment de facturation clôturé (comptabilité interne, append-only) ---
// Une ligne par segment d'offre clôturé : changement d'offre, passage à FREE, ou
// passage de mois civil. Le montant est proraté base 30 (plafonné à un mois
// plein) sur les jours du segment. Jamais mis à jour (hors le rattachement à une
// facture et la cascade). La facture mensuelle (modèle Invoice) encaissée est
// l'AGRÉGAT des segments d'un mois.
model BillingSegment {
  id             String        @id @default(cuid())
  plan           WorkspacePlan // offre facturée sur ce segment
  startedAt      DateTime      // début du segment (début de mois ou souscription)
  endedAt        DateTime      // clôture (changement effectif ou fin de mois)
  days           Int           // jours attribués au segment
  billableUsers  Int           // utilisateurs facturables sur la période du segment
  unitPriceCents Int           // prix unitaire de l'offre au moment de la clôture
  amountCents    Int           // montant proraté (base 30, plafonné à 1 mois)
  createdAt      DateTime      @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Facture mensuelle qui agrège ce segment (null tant qu'il n'est pas facturé).
  invoiceId   String?
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([invoiceId])
}

// Statut d'une facture mensuelle.
enum InvoiceStatus {
  PENDING // émise, en attente de paiement (échéance à 30 j)
  PAID // paiement constaté
}

// --- Facture mensuelle (une par espace et par mois civil) ---
// Agrégat des BillingSegment d'un mois civil terminé. Émise au traitement de nuit
// du 1er du mois suivant, terme échu, avec une échéance de paiement à 30 jours.
// Le détail nominatif des utilisateurs est recalculé à la demande depuis le
// journal d'appartenance (pas de snapshot) ; le montant, lui, est figé ici.
model Invoice {
  id          String        @id @default(cuid())
  periodStart DateTime      // 1er du mois facturé (minuit UTC)
  periodEnd   DateTime      // 1er du mois suivant (borne exclusive)
  amountCents Int           // agrégat des segments du mois
  status      InvoiceStatus @default(PENDING)
  issuedAt    DateTime      @default(now())
  dueAt       DateTime      // échéance de paiement (fin de mois + 30 j)
  paidAt      DateTime?     // horodatage du paiement constaté (null tant qu'impayé)
  createdAt   DateTime      @default(now())
  // Facture Stripe miroir (null = pas encore créée côté Stripe, ou espace sans
  // paiement Stripe configuré). Le webhook Stripe synchronise status/paidAt ici.
  stripeInvoiceId String? @unique

  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  segments    BillingSegment[]

  @@unique([workspaceId, periodStart]) // une seule facture par espace et par mois
  @@index([workspaceId])

  recoveryActions RecoveryAction[]
}

// Type d'action de recouvrement (journal d'audit superadmin).
enum RecoveryActionType {
  PAY // paiement d'une facture constaté (lève la coupure si plus aucune échue)
  REOPEN // réouverture sans paiement (geste commercial) — motif obligatoire
}

// --- Journal d'audit du recouvrement (append-only) ---
// Trace chaque action du superadmin depuis la console « Recouvrement » :
// constatation d'un paiement (PAY, rattaché à une facture) ou réouverture d'un
// espace sans paiement (REOPEN, motif obligatoire au niveau applicatif). Jamais
// mis à jour ni supprimé (hors cascade). Le script scripts/recouvrement.ts, outil
// d'exploitation hors application, n'écrit pas ici.
model RecoveryAction {
  id        String             @id @default(cuid())
  type      RecoveryActionType
  reason    String? // motif libre (requis pour REOPEN, côté applicatif)
  createdAt DateTime           @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Facture concernée pour un paiement (null pour une réouverture sans paiement).
  invoiceId   String?
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  // Superadmin auteur de l'action.
  actorId String
  actor   User   @relation("RecoveryActor", fields: [actorId], references: [id])

  @@index([workspaceId])
  @@index([createdAt])
}

// --- Tâche ---
// Modèle unique : une tâche est rattachée à un espace, avec éventuellement une
// tâche parente. Une tâche sans parent est présentée comme un « projet ».
model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  // Visibilité du projet (tâche racine) ; par défaut restreinte au créateur et
  // aux administrateurs, qui ajoutent ensuite les membres autorisés (ProjectAccess).
  visibility  ProjectVisibility @default(RESTRICTED)
  dueDate     DateTime?
  completedAt DateTime?
  // Ordre manuel au sein d'une même fratrie (réordonnable par glisser-déposer).
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Hiérarchie : une tâche peut être la sous-tâche d'une autre (même espace).
  // La suppression d'une tâche parente supprime ses sous-tâches en cascade.
  parentId String?
  parent   Task?  @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  children Task[] @relation("Subtasks")

  comments   Comment[]
  followers  TaskFollow[]
  activities TaskActivity[]
  // Documents liés à cette tâche (une tâche = une « action »).
  documentLinks DocumentLink[] @relation("TaskDocuments")
  // Documents dont cette tâche est le projet (tâche racine).
  projectDocuments Document[]  @relation("ProjectDocuments")
  // Décisions prises dans le cadre de cette tâche.
  decisions  Decision[]
  // Membres explicitement autorisés (projet restreint ; tâche racine uniquement).
  access     ProjectAccess[] @relation("ProjectAccess")

  @@index([workspaceId])
  @@index([assigneeId])
  @@index([parentId])
}

// --- Accès à un projet restreint ---
// Lie un projet (tâche racine) à un membre de l'espace autorisé à y accéder.
model ProjectAccess {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  // Rôle dans le projet. Le créateur est matérialisé comme ADMIN.
  role      ProjectMemberRole @default(MEMBER)

  taskId String
  task   Task   @relation("ProjectAccess", fields: [taskId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation("ProjectAccessUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
}

// --- Document joint (stocké en base, servi par /api/documents/[id]) ---
// Un document appartient à un projet (la tâche racine) et peut être lié à
// plusieurs tâches de ce projet via DocumentLink.
// Un document est soit un fichier téléversé, soit un lien vers une ressource externe.
enum DocumentKind {
  FILE
  LINK
}

model Document {
  id        String   @id @default(cuid())
  name      String // nom simplifié affiché
  // Type de document : fichier téléversé (FILE) ou lien externe (LINK).
  kind      DocumentKind @default(FILE)
  // Champs propres au fichier téléversé (null pour un lien).
  fileName  String? // nom de fichier d'origine
  mime      String?
  size      Int?
  data      Bytes?
  // Adresse externe (renseignée pour un LINK, null pour un fichier).
  url       String?
  createdAt DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectTaskId String
  projectTask   Task   @relation("ProjectDocuments", fields: [projectTaskId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User   @relation("DocumentUploader", fields: [uploadedById], references: [id])

  links DocumentLink[]
  decisions Decision[]

  @@index([projectTaskId])
  @@index([workspaceId])
}

// --- Décision prise dans le cadre d'une tâche ---
// Chaque tâche porte sa liste de décisions. Une décision peut référencer un
// document (du projet ou de la tâche) et être marquée « décision projet » :
// elle remonte alors dans l'onglet Décisions du projet (la tâche racine).
model Decision {
  id        String   @id @default(cuid())
  content   String
  // true = « décision projet » : remonte au niveau du projet (tâche racine).
  isProjectDecision Boolean @default(false)
  createdAt DateTime @default(now())

  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("DecisionAuthor", fields: [createdById], references: [id])
  // Document éventuellement associé (facultatif ; conservée si le document part).
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([documentId])
}

// --- Lien entre un document et une tâche (« action ») ---
model DocumentLink {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  taskId     String
  task       Task     @relation("TaskDocuments", fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([documentId, taskId])
  @@index([taskId])
}

// --- Journal d'activité d'une tâche (audit trail, en lecture seule) ---
model TaskActivity {
  id         String           @id @default(cuid())
  type       TaskActivityType
  fromValue  String? // ancienne valeur (statut/priorité/échéance/titre/ancien assigné)
  toValue    String? // nouvelle valeur
  targetName String? // nom d'une entité liée (assigné, sous-tâche…)
  // Identifiant de l'élément ciblé (commentaire, décision, document) : permet
  // de pointer précisément depuis le flux d'événements (ouvre l'onglet + surligne).
  targetId   String?
  // Regroupe les événements écrits en une seule fois (une sauvegarde multi-champs,
  // un commentaire et ses mentions) pour n'afficher qu'une ligne dans le flux.
  groupId    String?
  createdAt  DateTime         @default(now())

  taskId  String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId String
  actor   User   @relation("ActivityActor", fields: [actorId], references: [id])
  // Destinataire d'un événement ciblé (ex. mention). Null = événement de la
  // tâche, visible par tous ses suiveurs.
  targetUserId String?
  targetUser   User?   @relation("ActivityTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([targetUserId])
  @@index([groupId])
}

// --- Commentaire d'une tâche (discussion) ---
model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  editedAt  DateTime? // non null = message modifié après publication

  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation("CommentAuthor", fields: [authorId], references: [id])

  @@index([taskId])
}

// --- Suivi d'une tâche par un utilisateur (étoile) ---
model TaskFollow {
  id        String    @id @default(cuid())
  // following=false : la tâche n'est plus suivie, mais la discussion reste dans
  // la liste (sans compter en non-lu). lastReadAt : dernier message lu.
  following  Boolean   @default(true)
  lastReadAt DateTime?
  createdAt  DateTime  @default(now())

  userId String
  user   User   @relation("TaskFollower", fields: [userId], references: [id], onDelete: Cascade)
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([taskId])
}

// --- Demande de réinitialisation de mot de passe (lien envoyé par email) ---
// Un jeton aléatoire est envoyé dans le lien ; seul son hash est stocké.
model PasswordResetRequest {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Préférences de notification email d'un utilisateur (1-1 avec User) ---
// Cinq catégories métier (pas les 11 types techniques), chacune avec un canal
// { INSTANT · DIGEST · OFF }, plus un interrupteur maître et la cadence du digest.
// L'absence de ligne équivaut aux valeurs par défaut ci-dessous (opt-in sobre).
model NotificationPreference {
  id              String          @id @default(cuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled    Boolean         @default(true)
  mentions        NotifChannel    @default(INSTANT)
  assignments     NotifChannel    @default(INSTANT)
  discussions     NotifChannel    @default(DIGEST)
  taskChanges     NotifChannel    @default(DIGEST)
  dueReminders    NotifChannel    @default(INSTANT)
  digestFrequency DigestFrequency @default(DAILY)
  updatedAt       DateTime        @updatedAt
}

// --- File d'envoi + journal anti-doublon des notifications email ---
// Une ligne = un fait à notifier à un utilisateur. @@unique(userId, activityId)
// garantit qu'un même événement n'est jamais mailé deux fois (instantané puis
// digest). activityId null = envoi sans activité liée (ex. digest, rappel).
model NotificationOutbox {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId String? // lien TaskActivity (null pour digests / rappels)
  kind       String // INSTANT_MENTION, INSTANT_ASSIGN, INSTANT_FOLLOWER, DIGEST…
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, activityId])
  @@index([userId, sentAt])
}

// --- Demande de changement d'email (confirmation par lien envoyé au nouvel email) ---
model EmailChangeRequest {
  id        String   @id @default(cuid())
  newEmail  String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Statut de traitement d'une idée, piloté par le superadmin et affiché
// publiquement à tous les utilisateurs sur la page Idées.
enum IdeaStatus {
  EN_ATTENTE // reçue, pas encore arbitrée (défaut)
  A_LETUDE // retenue, en cours d'évaluation
  IMPLEMENTEE // réalisée
  ECARTEE // non retenue, écartée
}

// --- Idée d'amélioration (module transverse à l'application) ---
// Chaque utilisateur propose une idée et vote (pouce) pour celles des autres.
// L'interface n'affiche jamais que le pseudo ; le lien vers le compte (authorId)
// reste en base pour la fiabilité du vote mais n'est jamais renvoyé à la liste.
model Idea {
  id        String     @id @default(cuid())
  title     String
  body      String? // description optionnelle
  // Pseudo affiché de l'auteur, figé au moment du post (stable même si l'auteur
  // change de pseudo ensuite).
  pseudo    String
  // Statut de traitement, piloté par le superadmin (visible de tous).
  status    IdeaStatus @default(EN_ATTENTE)
  // Lien interne vers l'auteur, jamais affiché dans l'interface.
  authorId  String
  author    User       @relation("IdeaAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  votes     IdeaVote[]
  // Réponses officielles de l'équipe (superadmin), affichées publiquement.
  comments  IdeaComment[]

  @@index([authorId])
}

// --- Réponse officielle de l'équipe sur une idée ---
// Rédigée par un superadmin et affichée publiquement sous l'idée. L'auteur
// (authorId) sert la traçabilité interne ; l'interface n'expose que « l'équipe ».
model IdeaComment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  // Superadmin auteur de la réponse (jamais affiché nominativement).
  authorId  String
  author    User     @relation("IdeaCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ideaId])
}

// --- Pouce (vote) sur une idée ---
// Une ligne par (idée, utilisateur) : la contrainte d'unicité garantit un seul
// pouce par personne. L'identité n'est jamais exposée (on ne compte que les
// lignes ; personne ne voit qui a voté).
model IdeaVote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  // Lien interne vers le votant, jamais affiché.
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId]) // un pouce par personne
  @@index([ideaId])
}
