// Taskflow — Schéma de données (MVP)
// Gestion de projets et de tâches, inspiré d'Asana.
//
// Hiérarchie : Workspace (espace de travail partagé) → Project → Task.
// Les utilisateurs rejoignent un workspace via une Membership (rôle OWNER/MEMBER).
// Les tâches sont assignables à un membre du workspace, avec échéance et priorité.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 : l'URL de connexion est définie dans prisma.config.ts (migrations)
  // et passée au PrismaClient via le driver adapter (runtime, src/lib/prisma.ts).
}

// Rôle d'un utilisateur au sein d'un workspace.
enum WorkspaceRole {
  OWNER // créateur / administrateur du workspace
  MEMBER // membre pouvant créer des projets et des tâches
}

// Statut d'avancement d'une tâche.
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

// Priorité d'une tâche.
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

// --- Utilisateur ---
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  createdProjects Project[]  @relation("ProjectCreatedBy")
  createdTasks  Task[]       @relation("TaskCreatedBy")
  assignedTasks Task[]       @relation("TaskAssignee")
  sentInvitations Invitation[] @relation("InvitationInvitedBy")

  @@index([email])
}

// --- Espace de travail (équipe) ---
model Workspace {
  id         String    @id @default(cuid())
  name       String
  archivedAt DateTime? // non null = espace archivé (préalable à la suppression)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  members     Membership[]
  projects    Project[]
  invitations Invitation[]
}

// --- Invitation à rejoindre un workspace (par email) ---
// Un jeton aléatoire est envoyé dans le lien email ; seul son hash est stocké.
model Invitation {
  id          String        @id @default(cuid())
  email       String // destinataire (peut ne pas encore avoir de compte)
  tokenHash   String        @unique
  role        WorkspaceRole @default(MEMBER)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User      @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([workspaceId])
  @@index([email])
}

// --- Appartenance d'un utilisateur à un workspace ---
model Membership {
  id          String        @id @default(cuid())
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// --- Projet ---
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  tasks Task[]

  @@index([workspaceId])
}

// --- Tâche ---
model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([assigneeId])
}
