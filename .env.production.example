# Production — copier en `.env` SUR LE SERVEUR et remplir.
# Ne jamais committer le vrai .env (il est ignoré par git).

# Mot de passe de la base (choisir une valeur forte).
POSTGRES_PASSWORD=mot-de-passe-base-fort-a-changer

# URL de connexion : host "db" (réseau Docker interne), MÊME mot de passe que ci-dessus.
DATABASE_URL=postgresql://taskflow:mot-de-passe-base-fort-a-changer@db:5432/taskflow?schema=public

# Secret de signature des sessions (JWT). Générer :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=remplacer-par-un-secret-aleatoire-long

# Domaine public (sans https:// pour DOMAIN ; avec https:// pour APP_URL).
# www.getrida.com redirige automatiquement vers getrida.com (voir Caddyfile).
DOMAIN=getrida.com
APP_URL=https://getrida.com

# E-mail : "console" = aucun envoi (les liens d'invitation s'affichent dans les
# logs). Pour de vrais envois, mettre "smtp" et renseigner un fournisseur SMTP.
MAIL_TRANSPORT=console
# SMTP_HOST=
# SMTP_PORT=587
MAIL_FROM=Taskflow <no-reply@getrida.com>

# Durée de validité d'un lien d'invitation (jours).
INVITATION_TTL_DAYS=7

# Accès à la préproduction (staging.getrida.com), protégée par mot de passe.
# STAGING_USER : identifiant (par défaut "preview").
# STAGING_HASH : empreinte du mot de passe, générée par :
#   docker compose -f docker-compose.prod.yml exec caddy caddy hash-password --plaintext 'MON_MOT_DE_PASSE'
STAGING_USER=preview
STAGING_HASH=remplacer-par-l-empreinte-caddy
