# Identifiants d'accès à la PRÉPRODUCTION (staging.getrida.com), chargés par le
# service "caddy" (basic auth). Copier en `caddy.env` SUR LE SERVEUR (dans
# ~/taskflow) et remplir. NE PAS committer caddy.env (ignoré par git).

STAGING_USER=preview

# Empreinte (hash) du mot de passe — PAS le mot de passe en clair. Générer avec :
#   docker compose -f docker-compose.prod.yml exec caddy caddy hash-password --plaintext 'MON_MOT_DE_PASSE'
STAGING_HASH=remplacer-par-l-empreinte-caddy
