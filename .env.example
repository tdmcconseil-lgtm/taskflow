# Copier en `.env` et adapter les valeurs.

# Base de données PostgreSQL (docker-compose, port hôte 5433)
DATABASE_URL="postgresql://taskflow:taskflow_dev@localhost:5433/taskflow?schema=public"

# Secret de signature des sessions (JWT). Générer une valeur aléatoire longue :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="remplacer-par-un-secret-aleatoire"

# URL publique de l'application (liens d'invitation)
APP_URL="http://localhost:3001"

# Transport email : "console" (affiche dans la console) ou "smtp".
# En dev, "smtp" pointe sur Mailpit (docker-compose) — boîte web : http://localhost:8026
MAIL_TRANSPORT="smtp"
SMTP_HOST="localhost"
SMTP_PORT="1026"
MAIL_FROM="Taskflow <no-reply@taskflow.local>"

# Durée de validité d'un lien d'invitation, en jours
INVITATION_TTL_DAYS="7"
