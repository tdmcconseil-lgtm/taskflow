# Copier en `.env` et adapter les valeurs.

# Base de données PostgreSQL (docker-compose, port hôte 5433)
DATABASE_URL="postgresql://taskflow:taskflow_dev@localhost:5433/taskflow?schema=public"

# Secret de signature des sessions (JWT). Générer une valeur aléatoire longue :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="remplacer-par-un-secret-aleatoire"

# URL publique de l'application (liens d'invitation)
APP_URL="http://localhost:3001"

# Transport email : "console" (affiche dans la console) ou "smtp".
# En dev, "smtp" pointe sur Mailpit (docker-compose) — boîte web : http://localhost:8026
MAIL_TRANSPORT="smtp"
SMTP_HOST="localhost"
SMTP_PORT="1026"
MAIL_FROM="Taskflow <no-reply@taskflow.local>"

# Durée de validité d'un lien d'invitation, en jours
INVITATION_TTL_DAYS="7"

# --- Stripe (encaissement des factures mensuelles) ---
# Encaissement INACTIF si rien n'est défini ci-dessous (le code saute Stripe).
#
# Dev sans clé : utiliser stripe-mock (plomberie uniquement, pas de webhooks) :
#   docker run -d --rm --name stripe-mock -p 12111:12111 -p 12112:12112 stripe/stripe-mock
#   STRIPE_MOCK="1"
# STRIPE_MOCK_HOST / STRIPE_MOCK_PORT : surcharges optionnelles (défaut 127.0.0.1:12111).
#STRIPE_MOCK="1"
#
# Mode test / live : clé secrète (sk_test_… en bac à sable, sk_live_… en prod).
# Ne jamais committer de vraie clé ; la mettre dans .env (non versionné).
#STRIPE_SECRET_KEY="sk_test_xxx"
# Clé publiable (sk_test_… → pk_test_…), pour Stripe.js côté client si besoin.
#STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# Secret de signature du webhook, fourni par `stripe listen` ou le Dashboard.
#STRIPE_WEBHOOK_SECRET="whsec_xxx"
