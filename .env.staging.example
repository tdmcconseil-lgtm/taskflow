# Préproduction — copier en `.env` DANS ~/taskflow-staging SUR LE SERVEUR et remplir.
# Base de données SÉPARÉE de la prod (données de test, sans risque).

# Mot de passe de la base de préprod (différent de la prod).
POSTGRES_PASSWORD=mot-de-passe-base-preprod-a-changer

# URL de connexion : host "db" (réseau interne de la stack staging), MÊME mot de passe.
DATABASE_URL=postgresql://taskflow:mot-de-passe-base-preprod-a-changer@db:5432/taskflow?schema=public

# Secret de signature des sessions (différent de la prod). Générer :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=remplacer-par-un-secret-aleatoire-long

# Domaine de préprod.
DOMAIN=staging.getrida.com
APP_URL=https://staging.getrida.com

# E-mail. "console" = aucun envoi (liens d'invitation dans les logs).
# Pour tester de VRAIS envois en préprod sans écrire à de vrais invités :
#   - MAIL_TRANSPORT=smtp + SMTP_* ci-dessous (mêmes réglages OVH que la prod) ;
#   - MAIL_REDIRECT_TO : tous les mails partent vers cette seule adresse, le
#     destinataire réel étant rappelé dans le sujet « [→ …] ».
MAIL_TRANSPORT=console
MAIL_FROM=Taskflow (préprod) <no-reply@getrida.com>
# MAIL_REDIRECT_TO=thibaut.dumerle@gmail.com
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=587
# SMTP_USER=no-reply@getrida.com
# SMTP_PASS=le-mot-de-passe-de-la-boite-ovh

INVITATION_TTL_DAYS=7
